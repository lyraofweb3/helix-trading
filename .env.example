# AI providers (at least one required for run-once / background loop)
XAI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: protect POST /api/run-once (send header X-HELIX-Token)
HELIX_API_TOKEN=

# Background brain cycle interval in seconds. 0 = disabled. Default 300.
HELIX_POLL_SECONDS=300

# Where latest.json + journal.jsonl are written
SIGNAL_DIR=./signals

# HTTP port (Railway injects PORT automatically)
PORT=8080

# Optional model overrides
# HELIX_XAI_MODEL=grok-4.6
# HELIX_OPENAI_MODEL=gpt-4o-mini
# HELIX_ANTHROPIC_MODEL=claude-sonnet-4-20250514
