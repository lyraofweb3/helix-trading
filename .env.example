# AI providers (at least one required for run-once / background loop)
XAI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: protect POST /api/run-once (send header X-HELIX-Token)
HELIX_API_TOKEN=

# Background brain cycle interval in seconds. 0 = disabled. Default 300.
HELIX_POLL_SECONDS=300

# Continuous readiness watch (Auto Market). 0 = manual only.
# Quant path when AUTO_MARKET=1 — does not burn xAI credits each poll.
HELIX_AUTO_MARKET=1
HELIX_MAX_TRADES_PER_DAY=3

# Where latest.json + journal.jsonl are written
SIGNAL_DIR=./signals

# HTTP port (Railway injects PORT automatically)
PORT=8080

# Optional model overrides
# HELIX_XAI_MODEL=grok-4.6
# HELIX_OPENAI_MODEL=gpt-4o-mini
# HELIX_ANTHROPIC_MODEL=claude-sonnet-4-20250514

# HELIX 1.0
HELIX_MODE=PAPER
HELIX_V1=0
HELIX_V1_LLM=0
HELIX_DB_PATH=./data/helix.db
HELIX_ACCOUNT_BALANCE=50
HELIX_ACCOUNT_EQUITY=50
# HELIX_KILL_SWITCH=0
# HELIX_RISK_PERCENT=0.5
# HELIX_MAX_LOTS=1

# Trade Ideas / Holly AI (optional — file/webhook works without keys)
# TRADE_IDEAS_API_KEY=
# HOLLY_API_KEY=
# HOLLY_API_URL=
# HELIX_HOLLY_IDEAS_PATH=./data/holly_ideas.json

# swing (H1 default) | scalp (M5/M15) — both demo and live
HELIX_TRADE_STYLE=swing
# HELIX_SCALP_RISK_PERCENT=0.35
# HELIX_SCALP_MIN_RR=1.2
# HELIX_SCALP_SL_ATR=0.8
